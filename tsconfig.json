{
  // 继承 WXT 生成的 .wxt/tsconfig.json（先 wxt prepare 再跑 tsc/vitest）。
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["chrome"]
  }
}
